# Production settings for the mPod backend on AWS.
# Copy to /opt/mpod/backend/.env (owner mpod, chmod 600) and fill in every <...> value.
# (Or store these in AWS Secrets Manager / SSM Parameter Store and export them as
#  environment variables; real environment variables win over this file.)
# Never commit the real file.

NODE_ENV=production
PORT=8002
# Only nginx (same machine) reaches the API.
HOST=127.0.0.1

# ---- Database (MongoDB Atlas, your current database, or self-managed; must be a replica set)
MONGODB_URI=<mongodb+srv://user:password@cluster/mpod?retryWrites=true>
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=<long-random-secret>

# ---- Public address of the application
CORS_ORIGINS=https://<your-domain>
PUBLIC_BACKEND_URL=https://<your-domain>/backend/
COOKIE_SECURE=true
# loopback = nginx on this machine. Behind an AWS load balancer as well, use the number of proxies (e.g. 2).
TRUST_PROXY=loopback

# ==== AI: every model runs on the DGX Spark ====================================
# Values come from the DGX Spark team (docs/DGX_MODEL_CONTRACT.md, section 2).
AI_PROVIDER=dgx
# Backup while the DGX Spark is unreachable: openai (needs OPENAI_API_KEY) or none.
# With none, interviews still run (question bank + provisional scores, re-scored later).
AI_FALLBACK_PROVIDER=none

# Public HTTPS address of the DGX Spark gateway, and its API key
DGX_BASE_URL=https://<ai.your-domain>
DGX_API_KEY=<key from: sudo make-api-key.sh create aws-prod>
# ollama = Ollama on the DGX; openai = vLLM / TensorRT-LLM / SGLang (OpenAI-compatible API)
DGX_PROTOCOL=ollama

# Exact model names as served on the DGX Spark, one per task
DGX_SCORING_MODEL=gpt-oss:120b
DGX_GENERATION_MODEL=gpt-oss:20b
DGX_SUMMARY_MODEL=gpt-oss:20b
DGX_CODING_MODEL=qwen3-coder:30b

# Optional: a task on its own server, key or protocol (same pattern for GENERATION, SUMMARY, CODING)
# DGX_SCORING_URL=https://<scoring-server>
# DGX_SCORING_API_KEY=<key>
# DGX_SCORING_PROTOCOL=openai

# Camera model (coding interview). Leave empty to keep it in the students' browsers.
DGX_VISION_URL=https://<ai.your-domain>/vision
# Only if the vision service has its own key (default: DGX_API_KEY)
# DGX_VISION_API_KEY=<key>
# How often each student's browser sends a frame (ms)
# DGX_VISION_INTERVAL_MS=1000

# Requests sent to the DGX at once (match OLLAMA_NUM_PARALLEL / vLLM capacity)
DGX_MAX_CONCURRENCY=4
# Load the models into GPU memory when the backend starts (Ollama only)
DGX_PRELOAD=true
# Optional tuning (defaults shown)
# DGX_NUM_CTX=8192
# DGX_KEEP_ALIVE=-1
# DGX_THINK=auto                 # auto | true | false | low | medium | high
# DGX_REASONING_TOKENS=2048
# DGX_TIMEOUT_MS=300000
# DGX_INTERACTIVE_TIMEOUT_MS=90000
# DGX_VISION_TIMEOUT_MS=5000
# Self-signed certificate on the gateway instead of a public one? Point Node at its CA:
#   NODE_EXTRA_CA_CERTS=/opt/mpod/dgx-gateway-ca.pem   (set in the systemd unit, not here)

# Only if AI_FALLBACK_PROVIDER=openai
OPENAI_API_KEY=

# Evaluation throughput: interviews scored at once x AI calls per interview.
# DGX_MAX_CONCURRENCY above caps the real GPU load.
EVALUATION_CONCURRENCY=3
LLM_PARALLEL_CALLS=4

# ---- Email (Gmail app password) for OTPs and schedule notifications
EMAIL_USER=<sender@example.com>
EMAIL_PASS=<app-password>
