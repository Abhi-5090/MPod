# Production settings for the backend on the DGX Spark.
# Copy to /opt/mpod/backend/.env (owner mpod, chmod 600) and fill in every <...> value.
# Never commit the real file.

NODE_ENV=production
PORT=8002
# Only nginx (same machine) reaches the API.
HOST=127.0.0.1

# ---- Database (local replica set, see DEPLOY_DGX_SPARK.md step 4)
MONGODB_URI=mongodb://mpod_app:<db-password>@127.0.0.1:27017/mpod?replicaSet=rs0&authSource=mpod
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=<long-random-secret>

# ---- Public address
CORS_ORIGINS=https://<your-domain>
PUBLIC_BACKEND_URL=https://<your-domain>/backend/
COOKIE_SECURE=true
# nginx runs on this machine
TRUST_PROXY=loopback

# ---- AI: self-hosted models on this machine, OpenAI as backup
AI_PROVIDER=ollama
# Set to none to never send data to OpenAI.
AI_FALLBACK_PROVIDER=openai
OPENAI_API_KEY=<openai-key-or-leave-empty-if-no-fallback>

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_SCORING_MODEL=gpt-oss:120b
OLLAMA_GENERATION_MODEL=gpt-oss:20b
OLLAMA_SUMMARY_MODEL=gpt-oss:20b
OLLAMA_CODING_MODEL=qwen3-coder:30b
# Same as OLLAMA_NUM_PARALLEL on the Ollama server.
OLLAMA_MAX_CONCURRENCY=4
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=-1
# auto: gpt-oss thinks at low effort, other models answer directly.
OLLAMA_THINK=auto
OLLAMA_REASONING_TOKENS=2048
# Load the models into GPU memory when the backend starts.
OLLAMA_PRELOAD=true
# Optional timeouts (ms)
# OLLAMA_TIMEOUT_MS=300000
# OLLAMA_INTERACTIVE_TIMEOUT_MS=90000

# Evaluation throughput: interviews scored at once x AI calls per interview.
# The Ollama limit above caps the real GPU load; raise these only with more GPU capacity.
EVALUATION_CONCURRENCY=3
LLM_PARALLEL_CALLS=4

# ---- Email (Gmail app password) for OTPs and schedule notifications
EMAIL_USER=<sender@example.com>
EMAIL_PASS=<app-password>
