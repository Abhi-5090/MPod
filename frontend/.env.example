# (in development the Vite dev server proxies /backend to http://localhost:8002).
# Only set these if the API lives on a different domain. Both must end with "/".
# VITE_API_URL=https://mpod.ai/backend/api/
# VITE_BACKEND_URL=https://mpod.ai/backend/
