# Required
MONGODB_URI=mongodb://user:password@host1:27017,host2:27017/mpod?replicaSet=rs0
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# AI provider: openai (hosted) or ollama (self-hosted, e.g. NVIDIA DGX Spark).
# AI_FALLBACK_PROVIDER takes over while the primary is unavailable (none = never).
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=none

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=            # any OpenAI-compatible server (e.g. vLLM)
# Optional model overrides (defaults shown)
# OPENAI_SCORING_MODEL=gpt-4o
# OPENAI_GENERATION_MODEL=gpt-3.5-turbo
# OPENAI_SUMMARY_MODEL=gpt-3.5-turbo
# OPENAI_CODING_MODEL=gpt-4-turbo

# Ollama (defaults shown). See DEPLOY_DGX_SPARK.md for the server setup.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_SCORING_MODEL=gpt-oss:120b
# OLLAMA_GENERATION_MODEL=gpt-oss:20b
# OLLAMA_SUMMARY_MODEL=gpt-oss:20b
# OLLAMA_CODING_MODEL=qwen3-coder:30b
# OLLAMA_MAX_CONCURRENCY=4     # keep <= OLLAMA_NUM_PARALLEL on the Ollama server
# OLLAMA_NUM_CTX=8192
# OLLAMA_KEEP_ALIVE=-1
# OLLAMA_THINK=auto            # auto | true | false | low | medium | high
# OLLAMA_REASONING_TOKENS=2048
# OLLAMA_PRELOAD=true          # default: true in production
# OLLAMA_TIMEOUT_MS=300000
# OLLAMA_INTERACTIVE_TIMEOUT_MS=90000

# Email (Gmail app password) for OTPs and schedule notifications
EMAIL_USER=
EMAIL_PASS=

# Server
PORT=8002
# Interface to listen on; 127.0.0.1 when nginx runs on the same machine
# HOST=127.0.0.1
NODE_ENV=production
# Comma-separated list of front-end origins allowed to call the API with cookies
CORS_ORIGINS=https://mpod.ai
# Cookies are Secure (HTTPS-only) in production by default; set false only for plain-HTTP local testing
# COOKIE_SECURE=true
# Express trust proxy (set to 1 when running behind nginx / a load balancer on another host)
# TRUST_PROXY=loopback
# Public URL of this backend (used for technology icon links)
# PUBLIC_BACKEND_URL=https://mpod.ai/backend/

# Interview timing (minutes)
# INTERVIEW_START_GRACE_MINUTES=5
# INTERVIEW_EARLY_START_MINUTES=1
# INTERVIEW_SUBMIT_GRACE_MINUTES=10
# SESSION_HOURS=24
# KIOSK_SESSION_DAYS=365
# EVALUATION_CONCURRENCY=3
# LLM_PARALLEL_CALLS=4
