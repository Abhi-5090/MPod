# Copy to .env and fill in. All values are public (bundled into the browser build) — never put secrets here.

# mPod backend API base URL (must end with a slash)
REACT_APP_MPOD_BACKEND_URL=https://mpod.example.com/backend/api/

# Base URL for uploaded images (profile pictures etc.; must end with a slash)
REACT_APP_BACKEND_IMAGE_URL=https://mpod.example.com/backend/uploads/

# Student app base URL, used for interview report links and the kiosk setup link (must end with a slash)
REACT_APP_STUDENT_APP_URL=https://mpod.example.com/

# Public URL of this admin app
REACT_APP_PUBLIC_URL=https://mpod.example.com/admin
